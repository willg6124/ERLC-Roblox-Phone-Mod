# HOST (.exe Server Manager) ONLY — never put these in the Player Client,
# never commit them, never send them to a phone overlay.
# Copy to .env on the SERVER OWNER's machine only if you run the headless host.
ERLC_SERVER_KEY=
ERLC_GLOBAL_TOKEN=
HOST_PORT=3847
# Set to 1 ONLY for a local demo: exposes the pairing codes at /api/demo/codes
# so the web preview is try-able without opening the Host Manager. Never in production.
DEMO_MODE=0
